#include <bits/stdc++.h>
using namespace std;

int main() {
    int t,w,x,y,z;
    cin>>t;
    while(t--){
        cin>>w>>x>>y>>z;
        int fill=w+y*z;
        if(fill==x){
            cout<<"filled"<<endl;
        }
        else if(fill>x){
            cout<<"overflow"<<endl;
        }
        else{
            cout<<"unfilled"<<endl;
        }
    }
}
