#include <bits/stdc++.h>
using namespace std;
int main() {
    int n,t;
    cin>>t;
    while(t--){
        cin>>n;
        if(n<100 && n>=1){
            cout<<"easy"<<endl;
        }
        else if(n<200 && n>=100){
            cout<<"medium"<<endl;
        }
        else if(n<=300 && n>=200){
            cout<<"hard"<<endl;
        }
    }
}
