#include <bits/stdc++.h>
using namespace std;
int main() {
    int t,d,l,r;
    cin>>t;
    while(t--){
        cin>>d>>l>>r;
        if(l<=d && r>=d){
            cout<<"take second dose now"<<endl;
        }
        else if(l<=d && r<=d){
            cout<<"too late"<<endl;
        }
        else{
            cout<<"too early"<<endl;
        }
    }
}
