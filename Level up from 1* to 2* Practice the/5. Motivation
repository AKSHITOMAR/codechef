#include <bits/stdc++.h>
using namespace std;
int main() {
    int t,n,x;
    cin>>t;
    while(t--){
        cin>>n>>x;
        int max_rating=0;
        for(int i=0;i<n;i++){
            int s,r;
            cin>>s>>r;
            if(s<=x){
                max_rating=max(max_rating,r);
            }
        }
            cout<<max_rating<<endl;
        }
}
