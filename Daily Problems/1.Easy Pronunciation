using namespace std;
int main() {
    int t,n;
    cin>>t;
    while(t--){
        cin>>n;
        string s;
        cin>>s;
        bool hardpronounce=false;
          int count=0;
        for(int i=0;i<n;i++){
            if(s[i]=='a'||s[i]=='e'||s[i]=='i'||s[i]=='o'||s[i]=='u'){
                count=0;
            }
            else
             {
                count++;
                if(count>=4){
                    hardpronounce=true;
                    break;
                }
            }
    }
    cout<<(hardpronounce?"no":"yes")<<endl;
}
}
