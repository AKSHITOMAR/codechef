#include<vector>
using namespace std;
int main() {
    int t;
    cin>>t;
 while(t--){
        int n,x;
        cin>>n>>x;
        vector<int>a(n);
        for(int i=0;i<n;i++){
            cin>>a[i];
        }
 for(int i=0;i<n;i++){
     if(a[i]<=x) {
