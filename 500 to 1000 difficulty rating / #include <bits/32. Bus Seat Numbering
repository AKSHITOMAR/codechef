#include <bits/stdc++.h>
using namespace std;

int main() {
int t,n;
cin>>t;
while(t--){
    cin>>n;
    if(n>=1&&n<=10){
        cout<<"lower double"<<endl;
    }
    else if(n>=11 && n<=15){
        cout<<"lower single"<<endl;
    }
    else if(n>=16 && n<=25){
        cout<<"upper double"<<endl;
    }
    else{
        cout<<"upper single"<<endl;
    }
}
}
