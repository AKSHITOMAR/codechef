#include <bits/stdc++.h>
using namespace std;
int main() {
    int t,s,x,y,z;
    cin>>t;
    while(t--){
        cin>>s>>x>>y>>z;
       int memory=s-(x+y); 
       if(memory>=z)
       cout<<"0"<<endl;
       else if(memory+x>=z||memory+y>=z)
       cout<<"1"<<endl;
       else
       cout<<"2"<<endl;
    }
}
