#include <bits/stdc++.h>
using namespace std;
int main() {
int t,x;
cin>>t;
while(t--){
    cin>>x;
        if (x % 5 != 0) {
            cout << "-1" << endl;
        } else {
            int divi = x / 10;
            int remain = x % 10;
            if (remain == 0) {
                cout << divi << endl;
            } else {
                cout << (divi + 1) << endl;
            }
        }
}
}
