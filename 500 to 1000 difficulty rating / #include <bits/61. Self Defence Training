#include <bits/stdc++.h>
using namespace std;
int main() {
    int t;
    cin>>t;
    while(t--){
        int x,count=0;
        cin>>x;
        for(int i=0;i<x;i++){
            int age;
            cin>>age;
            if(10<=age && age<=60){
                count++;
            }
        }
        cout<<count<<endl;
}
}
