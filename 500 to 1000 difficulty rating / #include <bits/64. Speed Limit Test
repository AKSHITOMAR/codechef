#include <bits/stdc++.h>
using namespace std;
int main() {
	int t,a,x,b,y;
	cin>>t;
	while(t--){
	    cin>>a>>x>>b>>y;
	    if((double)a/x > (double)b/y){
	        cout<<"alice"<<endl;
	    }
	    else if((double)a/x == (double)b/y){
	        cout<<"equal"<<endl;
	    }
	    else {
	        cout<<"bob"<<endl;
	    }
	}
}
