#include <bits/stdc++.h>
using namespace std;
int main() {
int t,n,x;
cin>>t;
while(t--){
    cin>>n>>x;
    int count=0;
    vector<int>arr(n);
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    for(int i=0;i<n;i++){
        if(x<=arr[i]){
            count++;
        }
    }
    cout<<count<<endl;
}
}
